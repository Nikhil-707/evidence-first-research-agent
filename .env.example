# Select the configured chat-model provider: 'ollama' or 'groq'.
LLM_PROVIDER=ollama

# Ollama model and service address.
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434

# Groq API credentials and model. See https://console.groq.com/ for account access.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional LangSmith tracing. Set to true and configure a valid key to enable.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=research-agent
